<article class="detalle-mascota">
  <% if (mascota.imagen) { %>
    <img class="detalle-img" src="/img/<%= mascota.imagen %>" alt="<%= mascota.nombre %>">
  <% } %>
  <div class="detalle-info">
    <span class="chip"><%= mascota.especie %></span>
    <h1><%= mascota.nombre %></h1>
    <p class="raza"><strong>Raza:</strong> <%= mascota.raza %></p>
    <p class="edad">Edad <%= mascota.edad %> año<%= mascota.edad !== 1 ? 's' : '' %></p>
    <p class="descripcion"><%= mascota.descripcion %></p>
    <a class="boton" href="/mascotas">Volver al catálogo</a>
  </div>
</article>