<header class="cabecera-pagina">
    <div class="cabecera-texto">
        <h1><%= titulo %></h1>

        <p class="subtitulo">
            Encontrá un compañero que está esperando un hogar.
        </p>
    </div>

    <a class="boton boton-agregar" href="/mascotas/nueva">
        <span>＋</span> Agregar mascota
    </a>
</header>

<% if (!mascotas || mascotas.length === 0) { %>

    <!-- Mensaje alternativo cuando NO hay mascotas -->
    <section class="vacio">
        <h2>No hay mascotas disponibles</h2>
        <p>Actualmente no tenemos mascotas registradas en adopción. ¡Agregá la primera desde el botón superior!</p>
    </section>

<% } else { %>

    <!-- Se muestra la grilla solo si el arreglo TIENE elementos -->
    <section class="grilla" aria-label="Mascotas disponibles">
        <% mascotas.forEach((mascota) => { %>
            <article class="tarjeta">
                <img class="tarjeta-img" src="/img/<%= mascota.imagen %>" alt="<%= mascota.nombre %>">
                <div class="tarjeta-body">
                    <span class="chip"><%= mascota.especie %></span>
                    <h2><%= mascota.nombre %></h2>
                    <p class="raza"><%= mascota.raza %></p>
                    <div class="edad"> Edad <%= mascota.edad %> año<%= mascota.edad !== 1 ? "s" : "" %></div>
                    <p class="descripcion"><%= mascota.descripcion %></p>
                    <a class="boton-secundario" href="/mascotas/<%= mascota.id %>">Ver detalle</a>
                </div>
            </article>
        <% }) %>
    </section>

<% } %>